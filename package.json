{
  "name": "unit-converter-js",
  "version": "1.2.0",
  "description": "Simple, extensible unit conversion library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
